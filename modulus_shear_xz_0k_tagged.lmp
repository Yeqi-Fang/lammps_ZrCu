# 0 K AQS xz shear response from a tagged zero-pressure relaxed glass.
# Required command-line variables:
#   -var run_tag TAG -var strain VALUE

units           metal
dimension       3
boundary        p p p
atom_style      atomic

read_data       analysis_${run_tag}/moduli/Glass_Cu50Zr50_${run_tag}_0K_zeroP.dat

mass            1 63.546
mass            2 91.224

pair_style      eam/fs
pair_coeff      * * Cu-Zr_4.eam.fs Cu Zr

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

thermo          1000
thermo_style    custom step pe press pxz vol xz

variable        lz0 equal lz
variable        dxz equal ${strain}*v_lz0
change_box      all triclinic
change_box      all xz delta ${dxz} remap units box

min_style       fire
minimize        1.0e-10 1.0e-12 10000 100000

variable        tau_GPa equal -pxz*1.0e-4
variable        pxz_GPa equal pxz*1.0e-4
variable        pe_atom equal pe/atoms
variable        box_vol equal vol
variable        box_xz equal xz
print           "${strain} ${tau_GPa} ${pxz_GPa} ${pe_atom} ${box_vol} ${box_xz}" append analysis_${run_tag}/moduli/shear_xz_stress.dat screen no
